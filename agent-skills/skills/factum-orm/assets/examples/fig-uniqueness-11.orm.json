{
  "$schema": "https://www.factum-orm.com/schema/orm-model-2.schema.json",
  "version": 2,
  "name": "One to one",
  "objectTypes": [
    {
      "id": "person",
      "name": "Person",
      "kind": "entity",
      "refMode": "nr"
    },
    {
      "id": "company",
      "name": "Company",
      "kind": "entity",
      "refMode": "name"
    }
  ],
  "factTypes": [
    {
      "id": "works",
      "roles": [
        {
          "id": "works.r0",
          "objectTypeId": "person"
        },
        {
          "id": "works.r1",
          "objectTypeId": "company"
        }
      ],
      "readings": [
        {
          "id": "works.rd",
          "roleOrder": [
            "works.r0",
            "works.r1"
          ],
          "text": "{0} heads {1}",
          "isPrimary": true
        }
      ]
    }
  ],
  "subtypeRelations": [],
  "constraints": [
    {
      "id": "uc1",
      "kind": "uniqueness",
      "roles": [
        "works.r0"
      ]
    },
    {
      "id": "uc2",
      "kind": "uniqueness",
      "roles": [
        "works.r1"
      ]
    }
  ],
  "diagram": {
    "shapes": {
      "person": {
        "x": 40,
        "y": 60
      },
      "company": {
        "x": 300,
        "y": 60
      },
      "works": {
        "x": 196,
        "y": 68,
        "orientation": "horizontal"
      }
    }
  }
}
